# Local/ephemeral PostgreSQL only. Never point this at production.
# Migrator login (not the schema owner). Alembic SET LOCAL ROLE to the owner.
# Production/staging API runtime variable NAMES (no values here): see
# docs/PED-I01-PRODUCTION-RUNTIME-CONFIG-CONTRACT.md — do not treat this file
# as a production secret template.
AIEOS_DATABASE_URL=postgresql+psycopg://aieos_migrator:aieos_test@127.0.0.1:55432/aieos
AIEOS_SCHEMA_OWNER_ROLE=aieos_content_owner
# Distinct security schema owner for SAI-I02+ (migrator may SET ROLE; not a runtime).
AIEOS_SECURITY_SCHEMA_OWNER_ROLE=aieos_security_owner
